rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Add the (lowercase) e-mail addresses of your admins here.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['admin@yourcollege.edu'];
    }

    match /activities/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /solar/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reports/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
