rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Same admin list as firestore.rules.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['admin@yourcollege.edu'];
    }

    match /activities/{file} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024;
      allow delete: if isAdmin();
    }
    match /reports/{file} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isAdmin();
    }
  }
}
